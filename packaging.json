{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/run-purse",
    "name": "Purse",
    "sourceRepository": "https://github.com/just-every/run-purse",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile && pnpm exec rer install",
      "build": "pnpm run build",
      "verify": "pnpm run verify && pnpm exec rer check --profile first-party && pnpm check:deployment-spec && pnpm sources:check",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow OPERATIONS.md: retain exact source, a private native export and installation secrets; restore only into empty resources at the release that made the archive, verify records and original attachment bytes, then upgrade source in place. Preserve applied migration names and bytes."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@ff70d729948753ffdcceeca94aad063af2dcd979",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ],
    "pnpmVersion": "10.12.4"
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_LOCAL",
        "AUTH_ORIGIN",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID",
        "OWNER_EMAIL",
        "OIDC_PROVIDERS"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN",
        "PROTECTED_DATA_KEY"
      ],
      "optionalSecretNames": [
        "MAIL_API_KEY",
        "EMAIL_INTAKE_WEBHOOK_SECRET",
        "PROTECTED_DATA_PREVIOUS_KEY",
        "OIDC_CREDENTIALS",
        "OIDC_TRANSACTION_SECRET",
        "NOTIFICATION_WEBHOOK_SECRET"
      ],
      "healthPath": "/health",
      "recovery": "Follow OPERATIONS.md: retain exact source, a private native export and installation secrets; restore only into empty resources at the release that made the archive, verify records and original attachment bytes, then upgrade source in place. Preserve applied migration names and bytes.",
      "providerEffects": [
        "outbound-mail"
      ],
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      },
      "surfaces": {
        "app": {
          "path": "/signin",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": true,
            "ownerSignIn": "/auth/owner-signin"
          }
        }
      }
    }
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  }
}
