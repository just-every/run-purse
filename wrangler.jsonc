{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "procurement-purse",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundation",
      "database_id": "local-foundation-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ORIGINALS",
      "bucket_name": "purse-originals"
    }
  ]
}
