{
  "version": 1,
  "project": "just-every/procurement-purse",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "resend"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM",
      "verifyStandIn": "Purse <purse@example.com>"
    },
    {
      "binding": "EMAIL_INTAKE_WEBHOOK_SECRET",
      "environment": "EMAIL_INTAKE_WEBHOOK_SECRET",
      "optional": true
    },
    {
      "binding": "PROTECTED_DATA_KEY",
      "environment": "PROTECTED_DATA_KEY",
      "optional": true
    },
    {
      "binding": "OIDC_PROVIDERS",
      "environment": "OIDC_PROVIDERS",
      "optional": true,
      "verifyStandIn": "[]"
    },
    {
      "binding": "OIDC_CREDENTIALS",
      "environment": "OIDC_CREDENTIALS",
      "optional": true
    },
    {
      "binding": "OIDC_TRANSACTION_SECRET",
      "environment": "OIDC_TRANSACTION_SECRET",
      "optional": true
    }
  ],
  "platforms": [
    "workers",
    "container"
  ],
  "r2": [
    {
      "binding": "ORIGINALS"
    }
  ]
}
